# ==========================================================================
# EnerKrut — корневой .env для Docker Compose.
# Скопируй в .env и заполни значения. Файл .env НЕ коммитится в git.
# ==========================================================================

# ---------------------------- Telegram ------------------------------------
# Токен бота от @BotFather. Нужен для проверки initData и настройки меню.
# Пустое значение или TEST_TOKEN = демо-режим (подпись initData не защищена).
BOT_TOKEN=
# Username бота без @ (используется в подсказках и скриптах).
BOT_USERNAME=
# Публичный URL Mini App. Скрипт деплоя в Codespaces перезапишет это значение
# на актуальный адрес Cloudflare Tunnel. Для VPS укажи https://домен.
WEBAPP_URL=

# ---------------------------- PostgreSQL ----------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_DB=enerkrut

# ---------------------------- Порты ---------------------------------------
# Порт хоста, на который публикуется nginx (в контейнере всегда 80).
WEB_PORT=80

# --------------------- Сборка фронтенда (Vite) ----------------------------
# true — показывает в браузере кнопку входа с фейковым initData.
# Для реального продакшена выстави false.
VITE_ALLOW_DEV_AUTH=false
VITE_API_BASE_URL=/api

# ---------------------------- Деплой --------------------------------------
# Выполнять seed после миграций в scripts/deploy-vps.sh.
SEED_ON_DEPLOY=true
